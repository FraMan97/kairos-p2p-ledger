FROM golang:1.24-alpine AS builder
RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o ledger ./cmd/ledger/main.go

FROM alpine:3.19
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
RUN addgroup -S kairos && adduser -S kairos -G kairos
COPY --from=builder /app/ledger .
RUN mkdir -p /data && chown kairos:kairos /data
USER kairos
ENV DB_PATH=/data
EXPOSE 8080
ENTRYPOINT ["./ledger"]